cff-version: 1.2.0
message: "If you use this archive or the scholarship dataset, please cite them as below and keep the attribution string with any data you reuse."
title: "collegedata.fyi: Common Data Set archive and named scholarship directory"
type: software
authors:
  - name: "Anthony S. and Bolewood Group, LLC"
repository-code: "https://github.com/bolewood/quadfile"
url: "https://collegedata.fyi"
license: MIT
abstract: "Open-source archive of U.S. college Common Data Set documents, with a CC BY-SA 4.0 directory of named merit scholarship programs. Code is MIT. The scholarship data under data/scholarships is CC BY-SA 4.0. Attribution string for the scholarship data: Scholarship program data from collegedata.fyi (https://collegedata.fyi/scholarships), CC BY-SA 4.0. Terms as published by each school; see the source link on each record."
keywords:
  - common data set
  - college admissions
  - financial aid
  - merit scholarships
  - open data
references:
  - type: dataset
    title: "collegedata.fyi named scholarship directory"
    authors:
      - name: "Anthony S. and Bolewood Group, LLC"
    url: "https://collegedata.fyi/scholarships"
    repository-code: "https://github.com/bolewood/quadfile"
    license: CC-BY-SA-4.0
    notes: "Terms as published by each school; see the source link on each record."
