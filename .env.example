# collegedata.fyi — environment variables
#
# Copy this file to .env and fill in the real values.
# .env is gitignored; .env.example is committed as a template.
#
# Most values come from your Supabase project dashboard:
# https://app.supabase.com/project/<ref>/settings/api
# https://app.supabase.com/project/<ref>/settings/database

# ─── Supabase project identity ──────────────────────────────────────────────
# Project ref: the random string in your Supabase dashboard URL.
SUPABASE_PROJECT_REF=your-project-ref-here

# Project URL: https://<ref>.supabase.co
SUPABASE_URL=https://your-project-ref-here.supabase.co

# ─── Supabase API keys ──────────────────────────────────────────────────────
# Anon (public) key — safe to expose in client-side code and docs.
# Used by PostgREST for unauthenticated reads against tables with public policies.
# Dashboard: Settings > API > anon public
SUPABASE_ANON_KEY=

# Next.js exposes only NEXT_PUBLIC_* variables to browser code. Keep these in
# sync with SUPABASE_URL / SUPABASE_ANON_KEY for the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref-here.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NEVER commit, NEVER expose client-side.
# Bypasses Row-Level Security. Used by the Python worker and edge functions
# for writes to the manifest and Storage.
# Dashboard: Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase database ──────────────────────────────────────────────────────
# Database password: set during project creation. Needed by `supabase db push`
# for direct Postgres access. If you don't remember it, reset it in the
# dashboard: Settings > Database > Reset Database Password.
SUPABASE_DB_PASSWORD=

# Direct Postgres connection string, useful for psql / pgcli / pgAdmin.
# Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Dashboard: Settings > Database > Connection String > URI
DATABASE_URL=

# Dedicated direct or Supavisor session-mode URI for long IPEDS publication
# refreshes. `load_release.py --apply` intentionally does not use PostgREST or
# a transaction-mode pooler for these administrative calls.
IPEDS_ADMIN_DATABASE_URL=

# ─── Sentry (web app, optional overrides) ───────────────────────────────────
# Public DSN is safe to expose. The Next.js SDK also defaults to the committed
# collegedata-fyi DSN when this is unset.
NEXT_PUBLIC_SENTRY_DSN=
# Organization / project slugs for source-map upload. Defaults: bolewood / collegedata-fyi.
SENTRY_ORG=bolewood
SENTRY_PROJECT=collegedata-fyi
# Org auth token (secret). Needed only at Vercel build time to upload source maps.
# Scopes: org:read, project:releases. Leave unset locally; the build skips upload.
SENTRY_AUTH_TOKEN=

# ─── On-demand page revalidation (PR #262) ──────────────────────────────────
# Shared secret for POST /api/revalidate on the Next.js app. Set it in the Vercel
# project and in whatever runs the extraction worker. When unset, the endpoint
# returns 503 and the worker's notify step is a no-op.
REVALIDATE_SECRET=
# Full URL of the revalidate endpoint, used by tools/extraction_worker/revalidate_notify.py
# after data changes, e.g. https://collegedata.fyi/api/revalidate
COLLEGEDATA_REVALIDATE_URL=

# ─── Feedback form (web app, optional) ──────────────────────────────────────
# Formspree endpoints for the source-submission CTA and the /feedback page.
# The feedback form uses its own endpoint and falls back to the source-submission
# one. When neither is set the forms are disabled; there is no mailto fallback.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
NEXT_PUBLIC_FEEDBACK_FORMSPREE_ENDPOINT=

# ─── Supabase access token (optional) ───────────────────────────────────────
# Personal access token for `supabase` CLI commands that hit the Management API
# (e.g., creating/deleting projects via CLI). Not required for routine migration
# work if you use `supabase login` interactively.
# Dashboard: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=
