{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collegedata.fyi/schemas/scholarship-program.schema.json",
  "title": "collegedata.fyi named scholarship program (PRD 036 M1)",
  "description": "One file per program under data/scholarships/programs/<school_id>/<program_id>.yaml. Program-level fields plus one immutable version per entering class. Unknown is never false: use null, unknown, not_published or a conflicting field_evidence entry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "program_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "school_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "ipeds_id": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "applicable_campuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "official_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "program_family": {
      "enum": [
        "stamps",
        "national_merit",
        "presidential",
        "honors",
        "other"
      ]
    },
    "awarding_authority": {
      "enum": [
        "institution",
        "affiliated_foundation",
        "cofunded",
        "unknown"
      ]
    },
    "related_programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/related_program"
      }
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "closed_to_new_entrants",
        "merged",
        "discontinued",
        "unknown"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      },
      "minItems": 1
    }
  },
  "required": [
    "program_id",
    "school_id",
    "ipeds_id",
    "official_name",
    "program_family",
    "awarding_authority",
    "status",
    "versions"
  ],
  "$defs": {
    "related_program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "relation": {
          "enum": [
            "component_of",
            "includes",
            "replaces",
            "mutually_exclusive_with",
            "successor_to"
          ]
        }
      },
      "required": [
        "program_id",
        "relation"
      ]
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualifier": {
          "enum": [
            "exact",
            "range",
            "up_to",
            "at_least",
            "approximate",
            "not_published"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "period": {
          "enum": [
            "semester",
            "academic_year",
            "one_time",
            "total_program",
            null
          ]
        }
      },
      "required": [
        "qualifier"
      ],
      "description": "USD. A null amount object on a benefit means the amount is unknown or conflicting; qualifier not_published means the school says nothing about the figure. total_program amounts must be quoted by the school and carry field_evidence."
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "benefit_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "tuition",
            "mandatory_fees",
            "housing",
            "meals",
            "books",
            "laptop",
            "stipend",
            "study_abroad",
            "enrichment",
            "health_insurance",
            "other"
          ]
        },
        "instrument": {
          "enum": [
            "scholarship",
            "tuition_waiver",
            "cash_stipend",
            "restricted_fund",
            "earned_compensation",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "full",
            "partial",
            "fixed_amount",
            "variable",
            "unknown"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_terms": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "advertised_coverage_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The school's own words for what the benefit covers."
        },
        "normalized_coverage": {
          "enum": [
            "full_tuition",
            "full_tuition_fees",
            "tuition_housing_meals",
            "full_school_coa",
            "partial_or_fixed",
            "other",
            null
          ]
        }
      },
      "required": [
        "benefit_id",
        "category",
        "instrument",
        "coverage"
      ]
    },
    "test_rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exam": {
          "type": "string"
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "scoring": {
          "enum": [
            "single_sitting",
            "superscore",
            "unknown"
          ]
        },
        "official_required": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "exam"
      ]
    },
    "gpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "weighted",
            "unweighted",
            "recalculated_by_school",
            "unknown"
          ]
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "national_merit_statuses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "semifinalist",
              "finalist"
            ]
          },
          "uniqueItems": true
        },
        "first_choice_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "gpa": {
          "anyOf": [
            {
              "$ref": "#/$defs/gpa"
            },
            {
              "type": "null"
            }
          ]
        },
        "test_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test_rule"
          }
        },
        "tests_policy_for_scholarship": {
          "enum": [
            "required",
            "optional",
            "not_considered",
            "unknown"
          ]
        },
        "residency_eligible": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "in_state",
              "out_of_state",
              "international",
              "any"
            ]
          },
          "uniqueItems": true
        },
        "citizenship_eligible": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "us_citizen",
              "permanent_resident",
              "international",
              "any"
            ]
          },
          "uniqueItems": true
        },
        "majors_allowed": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "major_change_restrictions": {
          "type": [
            "string",
            "null"
          ]
        },
        "honors_requirement": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "first_generation_rule": {
          "enum": [
            "required",
            "considered",
            "not_considered",
            "unknown"
          ]
        },
        "eligibility_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "parent_offer_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "residency": {
          "enum": [
            "resident",
            "nonresident",
            "any",
            "unknown"
          ]
        },
        "selection_mode": {
          "enum": [
            "automatic_guaranteed",
            "competitive",
            "hybrid",
            "unknown"
          ]
        },
        "consideration_route": {
          "enum": [
            "admission_application",
            "separate_application",
            "honors_application",
            "nomination",
            "invitation",
            "multiple",
            "unknown"
          ]
        },
        "aid_basis": {
          "enum": [
            "merit_only",
            "merit_and_need",
            "unclear"
          ]
        },
        "need_role": {
          "enum": [
            "required",
            "considered",
            "not_considered",
            "top_up_only",
            "unknown"
          ]
        },
        "funds_limited": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "eligibility": {
          "$ref": "#/$defs/eligibility"
        },
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/benefit"
          }
        }
      },
      "required": [
        "offer_id",
        "selection_mode",
        "benefits"
      ]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "application_open",
            "application_deadline",
            "nomination_deadline",
            "supporting_materials_deadline",
            "test_score_deadline",
            "interview",
            "finalist_event",
            "notification",
            "acceptance_deadline",
            "other"
          ]
        },
        "requirement": {
          "enum": [
            "required",
            "priority",
            "recommended",
            "invitation_only"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "recurring": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                }
              },
              "required": [
                "month",
                "day"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "season",
            "approximate"
          ]
        },
        "source_date_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "requirement",
        "precision"
      ],
      "oneOf": [
        {
          "required": [
            "date"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "recurring": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "recurring"
          ],
          "properties": {
            "recurring": {
              "type": "object"
            },
            "date": {
              "type": "null"
            }
          }
        }
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "separate_application": {
          "enum": [
            "required",
            "encouraged",
            "not_required",
            "invitation_only",
            "unknown"
          ]
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "interview_mode": {
          "enum": [
            "none",
            "in_person",
            "virtual",
            "either",
            "unknown"
          ]
        },
        "finalist_event_required": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "separate_application",
        "milestones"
      ]
    },
    "renewal_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpa_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "gpa_scale": {
          "type": [
            "number",
            "null"
          ]
        },
        "credit_load_min_per_term": {
          "type": [
            "number",
            "null"
          ]
        },
        "evaluation_timing": {
          "type": [
            "string",
            "null"
          ]
        },
        "summer_courses_can_fix_shortfall": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "max_semesters": {
          "type": [
            "integer",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stacking_rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "other_aid_type": {
          "enum": [
            "institutional_merit",
            "institutional_need",
            "federal_or_state_need",
            "state_merit",
            "outside_scholarship",
            "athletic",
            "tuition_waiver",
            "other"
          ]
        },
        "relation": {
          "enum": [
            "allowed",
            "not_allowed",
            "replaces",
            "counts_within_package"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "other_aid_type",
        "relation"
      ]
    },
    "award_count": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "offers",
            "new_recipients",
            "target",
            "share_of_class"
          ]
        },
        "qualifier": {
          "enum": [
            "exact",
            "up_to",
            "at_least",
            "approximate",
            "not_published"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "cohort_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "metric",
        "qualifier",
        "source_ref"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "authority": {
          "enum": [
            "official_program",
            "official_aid_policy",
            "official_admissions",
            "official_news",
            "archived_official",
            "foundation_official"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      },
      "required": [
        "source_id",
        "url",
        "authority",
        "retrieved_at"
      ]
    },
    "field_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "type": "string",
          "description": "Slash path inside the version, e.g. offers/0/benefits/1/amount. Evidence on a parent path covers its children."
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "short_excerpt": {
          "type": [
            "string",
            "null"
          ],
          "description": "At most 25 words, quoted from the source."
        },
        "value_status": {
          "enum": [
            "reported",
            "not_published",
            "conflicting"
          ]
        },
        "reported_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "description": "The value this source reports; required in practice for conflicting entries."
        }
      },
      "required": [
        "field_path",
        "source_ref",
        "locator",
        "value_status"
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2000,
          "maximum": 2100
        },
        "entry_year_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Explicit unconfirmed label, used when entry_year is null."
        },
        "entry_terms": {
          "type": "array",
          "items": {
            "enum": [
              "fall",
              "spring",
              "summer",
              "unspecified"
            ]
          },
          "uniqueItems": true
        },
        "source_cohort_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "needs_review",
            "conflicting",
            "historical_only",
            "unverified"
          ]
        },
        "last_checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "last_reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_spot_checked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "next_reverify_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/offer"
          }
        },
        "application": {
          "anyOf": [
            {
              "$ref": "#/$defs/application"
            },
            {
              "type": "null"
            }
          ]
        },
        "renewal_rules": {
          "anyOf": [
            {
              "$ref": "#/$defs/renewal_rules"
            },
            {
              "type": "null"
            }
          ]
        },
        "stacking_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stacking_rule"
          }
        },
        "award_counts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/award_count"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "field_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_evidence"
          }
        }
      },
      "required": [
        "version_id",
        "entry_year",
        "verification_status",
        "last_checked_at",
        "offers",
        "sources",
        "field_evidence"
      ]
    }
  }
}
